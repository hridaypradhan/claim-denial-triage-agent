        "effective_from": "2026-01-01",
        "effective_to": null,
        "text": "MRI of the brain is considered medically necessary when criteria 3.1 and 3.2 are met. For CPT 70553 (without contrast, followed by with contrast), criterion 3.3 or criterion 3.4 must also be met."
      },
      "claim_id": "CLM-2026-005097",
      "payer": "BCBS_AZ",
      "procedure_code": "70553",
      "service_date": "2026-06-02",
      "tool_name": "retrieve_medical_policy",
      "request_id": "REQ-1",
